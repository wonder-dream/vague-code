Screen {
    layout: vertical;
    background: #0f1014;
    color: #cfd1d6;
    overflow: hidden;
}

* {
    scrollbar-size-horizontal: 0;
    scrollbar-background: transparent;
    scrollbar-color-hover: #6e6d72;
    scrollbar-background-hover: #303238;
    scrollbar-color-active: #7bba55;
    scrollbar-background-active: #303238;
    scrollbar-corner-color: transparent;
}

ScrollBarCorner {
    display: none;
}

#main {
    height: 1fr;
    background: #0f1014;
    overflow: hidden;
}

#app-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 28;
    min-width: 28;
    max-width: 28;
    background: #101114;
    border-right: solid #303238;
    padding: 1 0;
}

#sidebar.hidden {
    display: none;
}

.sidebar-header {
    color: #6e6d72;
    text-style: bold;
    padding: 0 1 0 1;
    margin: 0 0 1 0;
}

#session-rows {
    height: auto;
}

#session-rows > Static {
    padding: 0 1 0 1;
    color: #cfd1d6;
}

#session-rows > Static:hover {
    background: #1c1e24;
}

#session-rows > Static.sidebar-selected {
    background: #23252b;
    text-style: bold;
}

.topbar {
    height: auto;
    min-height: 2;
    padding: 0 2;
    background: #0f1014;
    color: #6e6d72;
    border-bottom: solid #303238;
    text-style: none;
}

#output {
    height: 1fr;
    padding: 1 3;
    background: #0f1014;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;
    scrollbar-color: #303238;
    scrollbar-background: #0f1014;
}

#output.welcome-active {
    align: center middle;
}

.welcome {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #0f1014;
    color: #cfd1d6;
}

.composer {
    height: auto;
    max-height: 9;
    margin: 0 2 0 2;
    background: #0f1014;
    border-top: solid #626263;
}

#input {
    height: 3;
    margin: 0;
    padding: 0 1;
    background: #0f1014;
    background-tint: transparent;
    color: #808185;
    border: none;
}

#input:focus {
    background: #0f1014;
    background-tint: transparent;
    color: #cfd1d6;
    border: none;
}

#input > .input--cursor {
    background: #cfd1d6;
    color: #0f1014;
    text-style: none;
}

#input > .input--selection {
    background: #0f1014;
    color: #cfd1d6;
}

#input > .text-area--placeholder {
    color: #808185;
}

.activity-line {
    height: 1;
    margin: 0 3;
    color: #527c3b;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1 0 1;
    background: #0f1014;
}

.system-message,
.command-message,
.reasoning-message,
.tool-message {
    color: #808185;
    background: #0f1014;
    border-left: solid #666769;
}

.tool-running,
.tool-done,
.tool-failed,
.tool-skipped,
.tool-denied {
    color: #808185;
    background: #0f1014;
    border-left: solid #666769;
}

.user-message {
    color: #cfd1d6;
    background: #0f1014;
    border-left: solid #50b7c2;
}

.assistant-message {
    color: #cfd1d6;
    background: #0f1014;
    border-left: solid #7bba55;
}

.assistant-message MarkdownBlock {
    margin: 0;
}

.reasoning-message {
    color: #527c3b;
    border-left: solid #7bba55;
}

.permission-message,
.permission-requested {
    color: #b28443;
    background: #0f1014;
    border-left: solid #b28443;
}

.error-message {
    color: #c85f5f;
    background: #0f1014;
    border-left: solid #c85f5f;
}

.streaming {
    border-left: solid #7bba55;
}

/* Confirm dialog (ADR-0027) */
ConfirmDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

#confirm-dialog {
    padding: 1 2;
    border: round #4a4c54;
    width: 60;
    max-width: 90%;
    height: auto;
    background: #16161a;
}

#confirm-title {
    text-style: bold;
    margin: 0 0 1 0;
    padding: 0 0 1 0;
    border-bottom: solid #303238;
}

.confirm-message {
    color: #cfd1d6;
    margin: 0 0 1 0;
    padding: 0 0 0 1;
    border-left: solid #4a4c54;
    background: #101114;
}

#confirm-buttons {
    height: 3;
    align: center middle;
    padding: 0;
}

#confirm-buttons Button {
    margin: 0 0 0 1;
    border: none;
    background: #23252b;
    color: #cfd1d6;
}

#confirm-buttons Button:focus {
    text-style: bold;
    background: #3a3d45;
    color: #ffffff;
}

#confirm-buttons Button.error {
    background: #4b2f2f;
    color: #e07c7c;
}

#confirm-buttons Button.error:focus {
    background: #5c3a3a;
    color: #ffb4b4;
}

/* Permission dialog */
PermissionDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

#permission-dialog {
    padding: 1 2;
    border: round #4a4c54;
    width: 68;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    background: #16161a;
    overflow-y: auto;
}

#perm-header {
    text-style: bold;
    margin: 0 0 1 0;
    padding: 0 0 1 0;
    border-bottom: solid #303238;
}

.perm-body {
    color: #cfd1d6;
    margin: 0 0 1 0;
    padding: 0 0 0 1;
    border-left: solid #4a4c54;
    background: #101114;
}

#perm-buttons {
    height: 3;
    align: center middle;
    padding: 0;
}

#perm-buttons Button {
    margin: 0 0 0 1;
    border: none;
    background: #23252b;
    color: #cfd1d6;
}

#perm-buttons Button:focus {
    text-style: bold;
    background: #3a3d45;
    color: #ffffff;
}

#perm-buttons Button.success {
    background: #2f4b3a;
    color: #7bba55;
}

#perm-buttons Button.success:focus {
    background: #3a5c46;
    color: #b8ffdf;
}

#perm-buttons Button.error {
    background: #4b2f2f;
    color: #e07c7c;
}

#perm-buttons Button.error:focus {
    background: #5c3a3a;
    color: #ffb4b4;
}

#perm-buttons Button.primary {
    background: #2f3d4b;
    color: #7bb2e0;
}

#perm-buttons Button.primary:focus {
    background: #3a4c5c;
    color: #c8e4ff;
}

.review-scroll {
    height: auto;
    max-height: 8;
    margin: 0 0 1 0;
    border: solid #303238;
    background: #101114;
    scrollbar-size-vertical: 1;
}

#perm-feedback-label {
    color: #808185;
    margin: 0 0 0 0;
}

#perm-feedback {
    height: 2;
    margin: 0 0 1 0;
    border: solid #303238;
    background: #101114;
    color: #cfd1d6;
}

#perm-feedback:focus {
    border: solid #7bba55;
}
